<div class="p-3">
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-12">
                    <label class="form-label">API Key</label>
                    @* Plain input instead of DxPassword: DxPassword forces autocomplete="current-password",
                       which lets the browser autofill a saved login password into this API key field. *@
                    <input type="password" class="dx-input" autocomplete="new-password" data-lpignore="true" data-1p-ignore
                           value="@SendGridApiKey" @onchange="@(e => SendGridApiKeyChanged.InvokeAsync(e.Value?.ToString()))" />
                </div>
                <div class="col-12">
                    <label class="form-label">From Email</label>
                    <DxTextBox Value="SendGridFromEmail" ValueChanged="@((string? v) => SendGridFromEmailChanged.InvokeAsync(v))" Placeholder="e.g. noreply@yourdomain.com" />
                    <div class="form-text">Must match a verified Sender Identity in SendGrid.</div>
                </div>
                <div class="col-12">
                    <DxButton Variant="primary" Text="Save Settings" OnClick="@(async (MouseEventArgs e) => await SaveClicked.InvokeAsync())" />
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public string? SendGridApiKey { get; set; }
    [Parameter] public EventCallback<string?> SendGridApiKeyChanged { get; set; }
    [Parameter] public string? SendGridFromEmail { get; set; }
    [Parameter] public EventCallback<string?> SendGridFromEmailChanged { get; set; }
    [Parameter] public EventCallback SaveClicked { get; set; }
}
