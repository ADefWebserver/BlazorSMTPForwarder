@using BlazorSMTPForwarder.ServiceDefaults.Models
@using BlazorSMTPForwarder.Web.GridRows

<div class="admin-page">
    <div class="admin-card">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-12 col-md-6">
                    <label class="form-label">Spamhaus Key</label>
                    @* Plain input instead of DxPassword: DxPassword forces autocomplete="current-password",
                       which lets the browser autofill a saved login password into this API key field. *@
                    <input type="password" class="dx-input" autocomplete="new-password" data-lpignore="true" data-1p-ignore
                           value="@SpamhausKey" @onchange="@(e => SpamhausKeyChanged.InvokeAsync(e.Value?.ToString()))" />
                    <div class="form-text">Spamhaus DQS Key</div>
                </div>

                <div class="col-12">
                    <div class="d-flex gap-4 mt-2">
                        <DxSwitch Value="EnableSpamFiltering" ValueChanged="@((bool v) => EnableSpamFilteringChanged.InvokeAsync(v))" Label="Enable Spamhaus Filtering" />
                        <DxSwitch Value="EnableSpfCheck" ValueChanged="@((bool v) => EnableSpfCheckChanged.InvokeAsync(v))" Label="Enable SPF Check" />
                        <DxSwitch Value="EnableDkimCheck" ValueChanged="@((bool v) => EnableDkimCheckChanged.InvokeAsync(v))" Label="Enable DKIM Check" />
                        <DxSwitch Value="EnableDmarcCheck" ValueChanged="@((bool v) => EnableDmarcCheckChanged.InvokeAsync(v))" Label="Enable DMARC Check" />
                    </div>
                </div>
                <div class="col-12">
                    <DxButton Variant="primary" Text="Save Settings" OnClick="@(async (MouseEventArgs e) => await SaveClicked.InvokeAsync())" />
                </div>
            </div>
        </div>
    </div>

    <div class="admin-card">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="m-0">Spam Logs</h5>
        <div class="d-flex gap-2">
            <DxButton Variant="primary" Text="Refresh" OnClick="@(async (MouseEventArgs e) => await RefreshClicked.InvokeAsync())" />
            @if (HasMore && !IsLoading)
            {
                <DxButton Variant="secondary" Text="More" OnClick="@(async (MouseEventArgs e) => await LoadMoreClicked.InvokeAsync())" />
            }
        </div>
    </div>

    <div class="mb-3">
        <label class="form-label" for="spam-log-filter">Filter spam logs</label>
        <input id="spam-log-filter" class="form-control" @bind="_filterText" @bind:event="oninput"
               placeholder="Search sender, recipient, subject, IP, or reason" />
    </div>

    @if (IsLoading && (Rows == null || Rows.Count == 0))
    {
        <div class="text-center p-3"><DxSpinner /></div>
    }
    else if (Rows == null || Rows.Count == 0)
    {
        <div class="text-muted">No spam logs found.</div>
    }
    else
    {
        <div class="dx-grid-resizable" data-grid-resize-key="spam-logs">
        <DxDataGrid TRow="SpamLogRow" Items="FilteredRows" Accessor="_spamAccessor"
                    Filterable="true" ShowFilterMenu="true" ShowExport="true"
                    ExportFileName="spam-logs.csv" ViewportHeight="520" />
        </div>
        @if (IsLoading)
        {
            <div class="mt-2 text-muted">Loading more...</div>
        }
    }
</div>
</div>

@code {
    [Parameter] public string? SpamhausKey { get; set; }
    [Parameter] public EventCallback<string?> SpamhausKeyChanged { get; set; }
    [Parameter] public bool EnableSpamFiltering { get; set; }
    [Parameter] public EventCallback<bool> EnableSpamFilteringChanged { get; set; }
    [Parameter] public bool EnableSpfCheck { get; set; }
    [Parameter] public EventCallback<bool> EnableSpfCheckChanged { get; set; }
    [Parameter] public bool EnableDkimCheck { get; set; }
    [Parameter] public EventCallback<bool> EnableDkimCheckChanged { get; set; }
    [Parameter] public bool EnableDmarcCheck { get; set; }
    [Parameter] public EventCallback<bool> EnableDmarcCheckChanged { get; set; }
    [Parameter] public IReadOnlyList<SpamLogRow>? Rows { get; set; }
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public bool HasMore { get; set; }
    [Parameter] public EventCallback SaveClicked { get; set; }
    [Parameter] public EventCallback RefreshClicked { get; set; }
    [Parameter] public EventCallback LoadMoreClicked { get; set; }

    private readonly SpamLogRowGridAccessor _spamAccessor = new();
    private string _filterText = "";

    private IReadOnlyList<SpamLogRow> FilteredRows => (Rows ?? Array.Empty<SpamLogRow>())
        .Where(row => string.IsNullOrWhiteSpace(_filterText)
            || $"{row.From} {row.To} {row.Subject} {row.IP} {row.DetectionReason}"
                .Contains(_filterText, StringComparison.OrdinalIgnoreCase))
        .ToList();
}
